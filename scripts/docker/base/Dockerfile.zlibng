FROM    alpine:latest
WORKDIR /z

RUN     apk upgrade -laU \
        && apk add py3-pip git make cmake gcc g++ musl-dev python3-dev zlib-ng-dev

RUN     pip wheel -v https://files.pythonhosted.org/packages/25/c8/2914b13c7972dccf8774947ffe781b761b483aa190e55a4aa89886982daa/zlib_ng-1.1.0.tar.gz \
        && mkdir whl \
        && mv *.whl whl
