{
  "short_name": "copyparty",
  "name": "copyparty",
  "description": "the all in one file server",
  "icons": [
    {
      "src": "/.cpr/copyparty.svg",
      "sizes": "512x512",
      "type": "image/svg+xml"
    }
  ],
  "start_url": "/?PWA",
  "display": "minimal-ui",
  "theme_color": "#222",
  "background_color": "#222",
  "share_target": {
    "action": "/?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "share",
      "text": "upload",
      "url": "/",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*", 
            "video/*", 
            "audio/*", 
            "text/*", 
            "application/*"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
 }